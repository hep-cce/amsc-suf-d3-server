name: "snbamsc_2dcnn_z"
platform: "onnxruntime_onnx"


max_batch_size: 64

input [
  {
    name: "zero_padding2d_1_input"
    data_type: TYPE_FP32
    dims: [ 480, 128, 1 ]
  }
]

output [
  {
    name: "dense_3"
    data_type: TYPE_FP32
    dims: [ 2 ]
  }
]


instance_group [
  { kind: KIND_GPU count: 1 }
]

model_repository_agents {
  agents [{
    name: "checksum"
    parameters {
      key: "MD5:1/model.onnx"
      value: "1ce50dba6561b9770dabe763a69de91a"
    }
  }]
}
